# Dashboard's OWN Bitunix API key — must have trade/withdraw UNCHECKED.
# Never reuse the trading bot's key. Missing/blank -> margin panel just
# shows "account margin unavailable"; everything else still works.
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# Only override these if the bot's install path or symbol changes.
# BITUNIX_SYMBOL=SOLUSDT
# BITUNIX_VIZ_PATH=/root/bots/v17mm/bitunix_mm/.v15mm_hl_viz.json
# BITUNIX_FILLS_PATH=/root/.v17mm_tracker/fills.jsonl

# BIND_HOST=127.0.0.1
# BIND_PORT=8091
