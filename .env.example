# Dashboard's OWN API keys — read-only where the venue supports scoping a
# key that way (trade/withdraw UNCHECKED). Never reuse a trading bot's key
# for anything with trade permission; a leaked read-only key can only ever
# reveal a balance, never move funds.
#
# Every block below is independent: leave a venue's lines blank/absent and
# that venue's margin panel just reports "account margin unavailable" —
# nothing else on the dashboard is affected.

# Bitunix — HMAC key/secret pair.
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=

# OKX — v5 API needs a THIRD secret (the passphrase chosen at key creation),
# not just key/secret. Without it every private call fails with 50105.
# OKX also enforces its IP allow-list against a specific IPv4 address, so the
# key must be scoped (or left unscoped) to the address this dashboard runs
# from — see okx_account.py's module docstring if this returns "50119 API
# key doesn't exist" despite correct credentials.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Coinbase — either a CDP JSON key file path (matches what v17mm's own .env
# already uses under this same name, so the bot's key file can be reused
# as-is) or a raw key/secret pair as the fallback.
COINBASE_KEY_FILE=
# COINBASE_API_KEY=
# COINBASE_API_SECRET=

# BIND_HOST=127.0.0.1
# BIND_PORT=8091
